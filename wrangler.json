{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oliots-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "oliots-website"
    }
  ]
}